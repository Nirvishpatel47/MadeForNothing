# =============================================================================
# MADE FOR NOTHING — Environment Configuration Template
# =============================================================================

# Database
# PostgreSQL connection string (e.g. Supabase, AWS RDS, local postgres)
DATABASE_URL=postgresql://postgres:password@localhost:5432/madefornothing

# Server & Routing
BASE_URL=http://localhost:8000
PUBLIC_HOST=0.0.0.0
PUBLIC_PORT=8000

# Admin Application (Localhost-Only Security)
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8001

# Application Authentication (Student Sessions)
JWT_SECRET_KEY=change-this-to-a-very-long-and-secure-random-secret-key-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Firebase Authentication (Google Sign-In & Email Auth)
# Obtain from Firebase Console -> Project Settings -> General -> Web App Config
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_REQUIRE_EMAIL_VERIFICATION=true

# Mux Video API (Direct Uploads & Signed Playback)
# Create in Mux Dashboard -> Settings -> Access Tokens (Mux Video Read/Write)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Mux Video Signing Key (Signed Playback JWTs)
# Create in Mux Dashboard -> Settings -> Signing Keys
# Key ID: 
MUX_SIGNING_KEY_ID=
# Private Key: RSA 2048-bit Private Key in PEM format (or Base64 encoded PEM string)
MUX_SIGNING_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Course Payment Settings (Manual Peer-to-Peer UPI)
COURSE_UPI_ID=madefornothing@upi
COURSE_PAYMENT_NAME=MADE FOR NOTHING

# Cloudflare R2 Storage (Article Featured Image Management)
# 1. Obtain Account ID from Cloudflare Dashboard -> R2 Overview.
# 2. Create an API Token: R2 Dashboard -> "Manage R2 API Tokens" -> "Create API Token" (Permission: Object Read & Write).
# 3. Create a Bucket in R2 (e.g. "madefornothing-images").
# 4. Enable Public Access on the bucket: Bucket Settings -> "Public Access" -> Connect custom domain or allow r2.dev subdomain.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=madefornothing-images
# Optional: defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com if left blank
R2_ENDPOINT_URL=
# Public Delivery URL: e.g. https://pub-xxxxxxxxxxxxxxxx.r2.dev or https://images.madefornothing.com
R2_PUBLIC_URL=https://pub-yourbucketid.r2.dev
# Optional: Maximum upload size in megabytes (default: 15)
R2_MAX_UPLOAD_SIZE_MB=15

